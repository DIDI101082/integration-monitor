# URL del servidor Elasticsearch
ES_URL=https://elasticsearch.accusys.com.ar

# Credenciales de Elasticsearch
ES_USERNAME=tu_usuario
ES_PASSWORD=tu_password

# Umbrales de alertas (opcional - valores por defecto indicados)
# SP lento: tiempo en ms a partir del cual se considera lento
UMBRAL_SP_LENTO=1000

# Volumen bajo: trx por hora mínimas antes de alertar
UMBRAL_VOLUMEN_BAJO=10

# Intervalo de auto-refresh en ms (opcional, default: 60000 = 1 minuto)
NEXT_PUBLIC_REFRESH_INTERVAL=60000
